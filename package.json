{
  "name": "@elithrar/artifacts-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Size-aware Git synchronization between GitHub and Cloudflare Artifacts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elithrar/artifacts-sync.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm types:check:example && pnpm test && pnpm build",
    "deploy:example": "pnpm build && wrangler deploy --config examples/cloudflare-worker/wrangler.jsonc",
    "dev:example": "pnpm build && wrangler dev --config examples/cloudflare-worker/wrangler.jsonc",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check src test examples/cloudflare-worker/src scripts vitest.config.ts",
    "prebuild": "node scripts/clean-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/cloudflare-worker/tsconfig.json",
    "types:check:example": "wrangler types --check --include-runtime false --config examples/cloudflare-worker/wrangler.jsonc examples/cloudflare-worker/worker-configuration.d.ts",
    "types:example": "wrangler types --include-runtime false --config examples/cloudflare-worker/wrangler.jsonc examples/cloudflare-worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@cloudflare/computer": "0.2.1",
    "isomorphic-git": "1.34.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260818.1",
    "@oxlint/plugins": "1.78.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0"
}
