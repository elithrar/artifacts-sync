{
  "name": "@elithrar/artifacts-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Size-aware Git synchronization between GitHub and Cloudflare Artifacts",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy:example": "pnpm build && wrangler deploy --config examples/cloudflare-worker/wrangler.jsonc",
    "dev:example": "pnpm build && wrangler dev --config examples/cloudflare-worker/wrangler.jsonc",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check src test vitest.config.ts",
    "prebuild": "tsc -b tsconfig.build.json --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types:example": "wrangler types --config examples/cloudflare-worker/wrangler.jsonc examples/cloudflare-worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@cloudflare/computer": "0.2.1",
    "isomorphic-git": "1.34.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260818.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0"
}
