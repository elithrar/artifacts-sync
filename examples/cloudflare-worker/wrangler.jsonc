{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "artifacts-sync-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "default",
    },
    {
      "binding": "STAGING_ARTIFACTS",
      "namespace": "staging",
    },
  ],
  "containers": [
    {
      "class_name": "SyncCoordinator",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 10,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_COORDINATOR",
        "class_name": "SyncCoordinator",
      },
    ],
  },
  "exports": {
    "SyncCoordinator": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "workflows": [
    {
      "name": "artifacts-sync-example",
      "binding": "SYNC_WORKFLOW",
      "class_name": "SyncWorkflow",
    },
  ],
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": {
          "namespace": "default",
          "repo_name": "example",
        },
        "targets": [
          {
            "type": "workflow",
            "workflow_name": "artifacts-sync-example",
          },
        ],
      },
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": {
          "namespace": "staging",
          "repo_name": "example",
        },
        "targets": [
          {
            "type": "workflow",
            "workflow_name": "artifacts-sync-example",
          },
        ],
      },
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
  },
}
